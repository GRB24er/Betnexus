# MongoDB
MONGODB_URI=mongodb://localhost:27017/betnexus

# Redis (optional - used for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="BetNexus <noreply@betnexus.com>"

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
