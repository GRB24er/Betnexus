# ─────────────────────────────────────────────────────────────
# BetNexus — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/betnexus

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Paystack ──────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# ── SMTP (Hostinger) ──────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@yourdomain.com
SMTP_PASS=your-email-password
EMAIL_FROM=BetNexus <admin@yourdomain.com>

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Odds API ──────────────────────────────────────────────────
ODDS_API_KEY=your-odds-api-key

# ── Redis (optional, for rate limiting) ───────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ── Admin ─────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret
